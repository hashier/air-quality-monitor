# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is gitignored so credentials never land in version control.

# WiFi networks (tried in order)
wifi_ssid: "your-primary-ssid"
wifi_password: "your-primary-password"
wifi_hackeriet_ssid: "your-secondary-ssid"
wifi_hackeriet_password: "your-secondary-password"

# Fallback captive-portal hotspot password
ap_password: "fallback-ap-password"

# air-quality-monitor
# Generate a fresh key with: openssl rand -base64 32
aqm_api_key: "base64-encoded-32-byte-key"
aqm_ota_password: "your-ota-password"
